# ----------------------------------------------------
# COLLABROOM ENVIRONMENT VARIABLES EXAMPLE
# ----------------------------------------------------

# PORT AND APPLICATION URLS
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:5000/api

# DATABASE (PostgreSQL)
# For local postgres: postgresql://postgres:postgres@localhost:5432/collabroom?schema=public
# For neon/supabase/render: add your connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/collabroom?schema=public"

# AUTHENTICATION (JWT)
JWT_SECRET="collabroom_super_secret_jwt_access_key_2026_production_ready"
JWT_REFRESH_SECRET="collabroom_super_secret_refresh_token_key_2026_production_ready"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# SUPABASE STORAGE
# Storage bucket for private workspace files
STORAGE_PROVIDER="supabase"
SUPABASE_URL="https://bxktvnrvpsoejetaxxaq.supabase.co"
SUPABASE_KEY="sb_publishable_QTVLYK3r6FTmaLLMi5hCyQ_loaZ3ikl"
SUPABASE_BUCKET="collabroom-files"

# EMAIL (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="notifications@collabroom.io"
SMTP_PASSWORD="smtp_password_here"
EMAIL_FROM="CollabRoom <no-reply@collabroom.io>"

# AI DOCUMENT ASSISTANT (RoomAI)
AI_API_KEY="optional_openai_or_gemini_key"

# REDIS (Optional for cache & rate limit)
REDIS_URL="redis://localhost:6379"
