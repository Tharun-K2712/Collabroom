{
  "name": "collabroom-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --workspace=backend run dev",
    "dev:frontend": "npm --workspace=frontend run dev",
    "build": "npm run build --workspaces --if-present",
    "test": "npm --workspace=backend test",
    "db:reset": "tsx backend/src/scripts/reset_db.ts",
    "cli": "node packages/cli/bin/collabroom.js"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
